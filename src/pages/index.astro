---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile.js';
import { withBase } from '../lib/paths.js';
---

<BaseLayout title="Nick Asendorf" description="Personal website for Nick Asendorf.">
  <section class="hero">
    <div class="hero-copy">
      <h1>{profile.name}</h1>
      <ul class="role-list" aria-label="Current roles">
        {profile.roles.map((role) => <li>{role}</li>)}
      </ul>
      <p>{profile.summary}</p>
    </div>
    <div class="hero-image">
      <img src={withBase(profile.image)} alt="Nick Asendorf" />
    </div>
  </section>
</BaseLayout>
